{
  "name": "Custom Dark Theme",
  "dataColors": ["#00B7C2", "#F45B69", "#FFD166", "#06D6A0", "#118AB2", "#EF476F"],
  "background": "#1E1E1E",
  "foreground": "#FFFFFF",
  "tableAccent": "#00B7C2",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 12
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#CCCCCC" } },
            "fontSize": 10
          }
        ],
        "background": [
          {
            "color": { "solid": { "color": "#1E1E1E" } }
          }
        ]
      }
    }
  }
}


